---
---
<header class="sint-framework-header">
    <div class="header-logo">
        <a href="/">SINT</a>
    </div>
    <button class="nav-toggle" id="nav-toggle" aria-label="Open Navigation">
        <span class="nav-toggle-line"></span>
        <span class="nav-toggle-line"></span>
    </button>
</header>

<div class="sint-framework-sidenav" id="sidenav">
    <div class="sidenav-overlay" id="sidenav-overlay"></div>
    <div class="sidenav-content">
        <div class="sidenav-header">
            <span class="sidenav-title">MENU</span>
            <button class="nav-close" id="nav-close" aria-label="Close Navigation">&times;</button>
        </div>
        <ul class="sidenav-links">
            <li><a href="/" class="nav-link"><span class="nav-num">01</span>TOP PAGE</a></li>
            <li><a href="https://sint-org.academia.edu/KoheiOkawa" target="_blank" rel="noopener noreferrer" class="nav-link"><span class="nav-num">02</span>CHRONICLE ↗</a></li>
            <li><a href="/docs" class="nav-link"><span class="nav-num">03</span>DOCS</a></li>
            <li><a href="/faq" class="nav-link"><span class="nav-num">04</span>FAQ</a></li>
            <li><a href="/apply" class="nav-link"><span class="nav-num">05</span>TESTAMENT</a></li>
        </ul>

        <!-- アカウントカード (JIS X 6301 / ID-1 規格 比率 8560:5398) -->
        <div class="sidenav-account-container">
            <!-- ログイン時：メンバーカード -->
            <div class="sint-id-card card-member" id="menuLoggedInCard" style="display: none;">
                <div class="card-top-row">
                    <span class="card-tag">MEMBER ACCOUNT</span>
                </div>
                <div class="card-mid-row">
                    <div class="card-user-name" id="menuCardName">MEMBER</div>
                    <div class="card-user-role" id="menuCardRole">AUTHENTICATED</div>
                </div>
                <div class="card-bottom-row">
                    <div class="card-actions" style="width: 100%; justify-content: space-between;">
                        <a href="/editor" class="card-action-btn">DASHBOARD ↗</a>
                        <button type="button" class="card-action-btn btn-logout" id="menuLogoutBtn">LOGOUT</button>
                    </div>
                </div>
            </div>

            <!-- 未ログイン時カード -->
            <div class="sint-id-card card-guest" id="menuGuestCard" style="display: none;">
                <div class="card-top-row">
                    <span class="card-tag">DOCS ACCOUNT</span>
                </div>
                <div class="card-mid-row">
                    <div class="card-user-name" style="font-size: 1.05rem;">NOT LOGGED IN</div>
                    <div class="card-user-role">Docs Management</div>
                </div>
                <div class="card-bottom-row">
                    <div class="card-actions" style="width: 100%; justify-content: flex-end;">
                        <a href="/editor/login" class="card-action-btn btn-login-accent" id="menuLoginLink">LOGIN ↗</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="sidenav-footer">
            SINT // THE MATHEMATICAL CRUCIBLE
        </div>
    </div>
</div>

<script>
    import { getToken, clearToken, verifySession } from '../lib/api';

    document.addEventListener('DOMContentLoaded', () => {
        const toggle = document.getElementById('nav-toggle');
        const close = document.getElementById('nav-close');
        const sidenav = document.getElementById('sidenav');
        const overlay = document.getElementById('sidenav-overlay');

        const openMenu = () => {
            sidenav?.classList.add('is-open');
        };

        const closeMenu = () => {
            sidenav?.classList.remove('is-open');
        };

        toggle?.addEventListener('click', openMenu);
        close?.addEventListener('click', closeMenu);
        overlay?.addEventListener('click', closeMenu);

        // Close menu on link click
        document.querySelectorAll('.nav-link').forEach(link => {
            link.addEventListener('click', closeMenu);
        });

        // Initialize Account Card
        const token = getToken();
        const loggedInCard = document.getElementById('menuLoggedInCard');
        const guestCard = document.getElementById('menuGuestCard');
        const cardName = document.getElementById('menuCardName');
        const cardRole = document.getElementById('menuCardRole');
        const logoutBtn = document.getElementById('menuLogoutBtn');
        const loginLink = document.getElementById('menuLoginLink') as HTMLAnchorElement | null;

        if (loginLink) {
            loginLink.href = `/editor/login?redirect=${encodeURIComponent(window.location.pathname + window.location.search)}`;
        }

        if (token) {
            if (loggedInCard) loggedInCard.style.display = 'flex';
            if (guestCard) guestCard.style.display = 'none';

            try {
                const cachedUser = JSON.parse(localStorage.getItem('sint_user') || '{}');
                if (cachedUser && (cachedUser.name || cachedUser.username)) {
                    if (cardName) cardName.textContent = cachedUser.name || cachedUser.username;
                    if (cardRole) cardRole.textContent = `${(cachedUser.roleTitle || cachedUser.role || 'MEMBER').toUpperCase()}`;
                }
            } catch (e) {}

            verifySession().then(({ valid, user }) => {
                if (valid && user) {
                    if (cardName) cardName.textContent = user.username;
                    if (cardRole) cardRole.textContent = user.roleTitle ? user.roleTitle : (user.role || 'MEMBER').toUpperCase();
                    try {
                        localStorage.setItem('sint_user', JSON.stringify(user));
                    } catch (e) {}
                } else if (!valid) {
                    clearToken();
                    localStorage.removeItem('sint_user');
                    if (loggedInCard) loggedInCard.style.display = 'none';
                    if (guestCard) guestCard.style.display = 'flex';
                }
            });
        } else {
            if (loggedInCard) loggedInCard.style.display = 'none';
            if (guestCard) guestCard.style.display = 'flex';
        }

        logoutBtn?.addEventListener('click', () => {
            clearToken();
            localStorage.removeItem('sint_user');
            window.location.reload();
        });
    });
</script>

<style>
.sidenav-account-container {
    margin-top: auto;
    margin-bottom: 24px;
    width: 100%;
}

.sint-id-card {
    width: 100%;
    aspect-ratio: 8560 / 5398;
    border-radius: 8px;
    padding: 16px 18px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    border: 1px solid var(--border-color);
    background: transparent;
    transition: border-color 0.2s ease;
}

.sint-id-card:hover {
    border-color: var(--text-color);
}

.card-member {
    border: 1px solid var(--border-color);
    background: transparent;
}

.card-guest {
    border: 1px dashed var(--border-color);
    background: transparent;
}

.card-top-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
}

.card-tag {
    font-family: var(--font-en);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--text-muted);
}

.card-mid-row {
    margin: auto 0;
}

.card-user-name {
    font-family: var(--font-en);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-color);
    letter-spacing: 0.04em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.card-user-role {
    font-family: var(--font-en);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-top: 3px;
}

.card-bottom-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border-color);
    padding-top: 10px;
}

.card-actions {
    display: flex;
    gap: 8px;
    align-items: center;
}

.card-action-btn {
    font-family: var(--font-en);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--text-color);
    text-decoration: none;
    background: transparent;
    border: 1px solid var(--border-color);
    padding: 3px 8px;
    cursor: pointer;
    transition: all 0.2s;
    line-height: 1.4;
}

.card-action-btn:hover {
    background: var(--text-color);
    color: var(--bg-color) !important;
}

.btn-login-accent {
    border-color: var(--text-color);
    background: var(--text-color);
    color: var(--bg-color) !important;
}

.btn-login-accent:hover {
    opacity: 0.85;
}

.btn-logout {
    border-color: transparent;
    opacity: 0.7;
}

.btn-logout:hover {
    background: transparent;
    color: #ef4444 !important;
    opacity: 1;
}
</style>
