---
import Layout from '../../layouts/Layout.astro';
import { getAuthor } from '../../data/authors';

// Fetch all astro pages under the current folder using Vite's glob
const posts = import.meta.glob('./*.astro', { eager: true });

// Filter out the index page and construct URLs dynamically
const articles = Object.entries(posts)
    .map(([filePath, module]) => {
        const name = filePath.replace(/^\.\//, '').replace(/\.astro$/, '');
        const url = `/docs/${name}`;
        return {
            ...module,
            url,
            filePath
        };
    })
    .filter(post => !post.filePath.endsWith('index.astro') && (post as any).title)
    .sort((a, b) => {
        const dateA = new Date((a as any).publishedDate?.replace(/\./g, '-') || 0).getTime();
        const dateB = new Date((b as any).publishedDate?.replace(/\./g, '-') || 0).getTime();
        return dateB - dateA;
    });
---

<Layout title="SINT - Docs / 技術仕様書" description="Scratch数論研究会(SINT)の技術仕様書、学術資料、および研究ノート。">
    <!-- ヒーローセクション -->
    <section class="faq-hero">
        <h1 class="apply-title reveal-up">DOCS</h1>
        <p class="apply-subtitle reveal-up" data-reveal-delay="0.1s">RESEARCH & SPECIFICATIONS // 技術仕様・研究ノート</p>
    </section>

    <!-- 記事一覧セクション -->
    <!-- 記事一覧セクション -->
    <section class="content-section">
        <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem;">
            <div>
                <span class="section-num reveal-up">01 / ARCHIVES</span>
                <h2 class="section-text reveal-up">公開仕様書・研究資料</h2>
            </div>
            <a href="/editor" class="editor-portal-link reveal-up">SPEC EDITOR ↗</a>
        </div>

        <div class="docs-list" id="docsList">
            {articles.map(article => (
                <div class="docs-item reveal-up" data-spec-id={article.specId} data-date={article.publishedDate}>
                    <div class="docs-meta">
                        <span class="docs-num">{article.specId}</span>
                        <span class="docs-tag">{article.tag}</span>
                    </div>
                    <div class="docs-content">
                        <h3 class="docs-title">
                            <a href={article.url}>{article.title}</a>
                        </h3>
                        <p class="docs-desc">
                            {article.description}
                        </p>
                        <div class="docs-footer-meta">
                            <span class="docs-date">PUBLISHED: {article.publishedDate}</span>
                            <span class="docs-date">Written by: {typeof (article as any).author === 'string' ? getAuthor((article as any).author).name : ((article as any).author?.name || (article as any).author || 'Unknown')}</span>
                            <a href={article.url} class="docs-readmore">READ SPECIFICATION ↗</a>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </section>

    <script>
        import { fetchSpecs } from '../../lib/api';

        const docsList = document.getElementById('docsList');

        async function mergeDynamicSpecs() {
            if (!docsList) return;
            try {
                const dynamicSpecs = await fetchSpecs();
                console.log('[SINT Docs] Fetched dynamic specs:', dynamicSpecs);
                if (!dynamicSpecs || dynamicSpecs.length === 0) return;

                // Collect existing URLs to avoid duplicate rendering
                const existingUrls = new Set<string>();
                document.querySelectorAll('.docs-title a').forEach(a => {
                    const href = a.getAttribute('href');
                    if (href) existingUrls.add(href.replace(/\/$/, ''));
                });

                let addedNew = false;
                for (const spec of dynamicSpecs) {
                    const viewUrl = `/docs/view?slug=${encodeURIComponent(spec.slug)}`;
                    if (existingUrls.has(viewUrl)) continue;

                    const item = document.createElement('div');
                    item.className = 'docs-item reveal-up is-revealed';
                    item.style.opacity = '1';
                    item.style.transform = 'none';
                    item.setAttribute('data-spec-id', spec.specId);
                    item.setAttribute('data-date', spec.publishedDate);

                    item.innerHTML = `
                        <div class="docs-meta">
                            <span class="docs-num">${spec.specId}</span>
                            <span class="docs-tag">${spec.tag}</span>
                        </div>
                        <div class="docs-content">
                            <h3 class="docs-title">
                                <a href="${viewUrl}">${spec.title}</a>
                            </h3>
                            <p class="docs-desc">
                                ${spec.description || ''}
                            </p>
                            <div class="docs-footer-meta">
                                <span class="docs-date">PUBLISHED: ${spec.publishedDate}</span>
                                <span class="docs-date">Written by: ${spec.author || 'Collaborator'}</span>
                                <a href="${viewUrl}" class="docs-readmore">READ SPECIFICATION ↗</a>
                            </div>
                        </div>
                    `;

                    docsList.appendChild(item);
                    addedNew = true;
                    console.log(`[SINT Docs] Added dynamic spec: ${spec.title} (${spec.slug})`);
                }

                // Sort all items in docsList by publishedDate descending (newest first)
                const allItems = Array.from(docsList.querySelectorAll<HTMLElement>('.docs-item'));
                allItems.sort((a, b) => {
                    const dateA = new Date(a.getAttribute('data-date')?.replace(/\./g, '-') || 0).getTime();
                    const dateB = new Date(b.getAttribute('data-date')?.replace(/\./g, '-') || 0).getTime();
                    return dateB - dateA;
                });

                // Re-append in sorted order
                allItems.forEach(item => docsList.appendChild(item));

            } catch (err) {
                console.warn('[SINT Docs] Dynamic specs could not be loaded:', err);
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', mergeDynamicSpecs);
        } else {
            mergeDynamicSpecs();
        }
    </script>
</Layout>

<style is:global>
.docs-list {
    display: flex;
    flex-direction: column;
    width: 100%;
    margin-top: 2rem;
}

.editor-portal-link {
    font-family: var(--font-en);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-muted);
    text-decoration: none;
    border: 1px solid var(--grid-color);
    padding: 0.4rem 0.8rem;
    transition: all 0.3s;
}

.editor-portal-link:hover {
    color: var(--text-color);
    border-color: var(--border-color);
}

.docs-item {
    border-bottom: 1px solid var(--grid-color);
    padding: 3rem 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    transition: border-color 0.5s;
}

@media (min-width: 768px) {
    .docs-item {
        grid-template-columns: 0.3fr 1fr;
        gap: 3rem;
    }
}

.docs-item:first-child {
    border-top: 1px solid var(--grid-color);
}

.docs-item:hover {
    border-bottom-color: var(--border-color);
}

.docs-meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.docs-num {
    font-family: var(--font-en);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
    color: var(--text-color);
}

.docs-tag {
    display: inline-block;
    font-family: var(--font-en);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 3px 8px;
    border: 1px solid var(--text-color);
    align-self: flex-start;
}

.docs-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.docs-title a {
    color: var(--text-color);
    text-decoration: none;
    font-size: 1.6rem;
    font-weight: 900;
    line-height: 1.3;
    transition: opacity 0.3s;
}

.docs-title a:hover {
    opacity: 0.7;
}

.docs-desc {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-muted);
}

.docs-footer-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1rem;
    flex-wrap: wrap;
    gap: 1rem;
}

.docs-date {
    font-family: var(--font-en);
    font-size: 0.85rem;
    color: var(--text-muted);
}

.docs-readmore {
    font-family: var(--font-en);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-color);
    text-decoration: none;
    border-bottom: 1px solid var(--text-color);
    padding-bottom: 2px;
    transition: opacity 0.3s;
}

.docs-readmore:hover {
    opacity: 0.7;
}
</style>
